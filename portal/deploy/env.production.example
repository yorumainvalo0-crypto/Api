# Template for librechat.env (LibreChat's settings). ./start.sh (scripts/setup-env.py) fills in the
# REPLACE_ME values with fresh secrets on the first run – no need to edit this file.

HOST=localhost
PORT=3080
# The only published port (127.0.0.1): portal-nginx, where the server's nginx forwards the domain to
PORTAL_HTTP_PORT=45012
PORTAL_DOMAIN=ai.dev.a-b-cloud.de
DOMAIN_CLIENT=https://ai.dev.a-b-cloud.de
DOMAIN_SERVER=https://ai.dev.a-b-cloud.de
TRUST_PROXY=1
NO_INDEX=true
# No Meilisearch in this stack (conversation search off)
SEARCH=false
APP_TITLE=A-B Cloud AI Portal

# Providers: Claude direct and agents (tools). Add ",custom" to show OpenRouter chat models later.
ENDPOINTS=anthropic,agents
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-5-5
# Used by the portal gateway's media tools (image/speech/video), not shown as chat models
OPENROUTER_KEY=sk-or-REPLACE_ME

# Code execution and file output: the portal code runner (portal/code-runner)
LIBRECHAT_CODE_BASEURL=http://code-runner:8000/v1

# Login only through the portal gateway (milestone M3).
# Until then: ALLOW_EMAIL_LOGIN=true and create accounts with `npm run create-user`.
ALLOW_EMAIL_LOGIN=false
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=true
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_PASSWORD_RESET=false
ALLOW_SHARED_LINKS_PUBLIC=false
OPENID_ISSUER=https://ai.dev.a-b-cloud.de/portal/oidc
OPENID_CLIENT_ID=librechat
OPENID_CLIENT_SECRET=REPLACE_ME
OPENID_SESSION_SECRET=REPLACE_ME
OPENID_SCOPE="openid profile email"
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_USERNAME_CLAIM=preferred_username
OPENID_ADMIN_ROLE=admin
OPENID_ADMIN_ROLE_PARAMETER_PATH=roles
OPENID_ADMIN_ROLE_TOKEN_KIND=id
OPENID_AUTO_REDIRECT=true
OPENID_BUTTON_LABEL=Anmelden

# LibreChat re-checks the gateway's device session daily (invisible redirect), so revoking a
# device in the admin area takes effect within a day; blocking a user takes effect at once
REFRESH_TOKEN_EXPIRY=(1000 * 60 * 60 * 24) * 1

# Per-user message rate limit (messages per window in minutes)
LIMIT_MESSAGE_USER=true
MESSAGE_USER_MAX=40
MESSAGE_USER_WINDOW=1

# Secret shared with the portal gateway's media MCP server (milestone M7)
PORTAL_MCP_TOKEN=REPLACE_ME

# Secrets
CREDS_KEY=REPLACE_ME_64_HEX
CREDS_IV=REPLACE_ME_32_HEX
JWT_SECRET=REPLACE_ME
JWT_REFRESH_SECRET=REPLACE_ME
MEILI_MASTER_KEY=REPLACE_ME
ADMIN_PANEL_SESSION_SECRET=REPLACE_ME
