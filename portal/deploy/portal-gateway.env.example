# Portal gateway configuration. Copy to /opt/LibreChat/portal-gateway.env and fill in.
# Generate secrets with: openssl rand -hex 32

PUBLIC_URL=https://ai.dev.a-b-cloud.de
MONGO_URI=mongodb://mongodb:27017
PORTAL_SECRET=REPLACE_ME_64_HEX
# Must equal OPENID_CLIENT_SECRET in LibreChat's .env
OIDC_CLIENT_SECRET=REPLACE_ME
# Must equal PORTAL_MCP_TOKEN in LibreChat's .env
PORTAL_MCP_TOKEN=REPLACE_ME
USER_EMAIL_DOMAIN=users.ai.dev.a-b-cloud.de

# First admin (created once on first start; log in at /portal/admin/login and set up TOTP)
PORTAL_ADMIN_USERNAME=admin-name
PORTAL_ADMIN_PASSWORD=REPLACE_ME_LONG_PASSWORD

# Media tools via OpenRouter (image, speech, video)
OPENROUTER_API_KEY=sk-or-REPLACE_ME
MEDIA_DIR=/data/media
MEDIA_RETENTION_DAYS=30
IMAGE_MODEL=google/gemini-2.5-flash-image
TTS_MODEL=openai/gpt-4o-mini-tts-2025-12-15
TTS_VOICE=alloy
VIDEO_MODEL=google/veo-3.1
# Minimum remaining balance before a request is sent (rough upper cost per call, USD)
IMAGE_MIN_BALANCE_USD=0.2
TTS_MIN_BALANCE_USD=0.05
VIDEO_MIN_BALANCE_USD=3
