{
  "name": "portal-gateway",
  "version": "0.1.0",
  "private": true,
  "description": "Login, invites, budgets, usage dashboard and tools for the A-B Cloud AI Portal (LibreChat).",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "dev": "tsx watch src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.3",
    "@fastify/formbody": "9.0.1",
    "@fastify/rate-limit": "11.2.1",
    "@modelcontextprotocol/sdk": "1.32.1",
    "fastify": "5.12.7",
    "mongodb": "6.20.0",
    "oidc-provider": "9.12.2",
    "qrcode": "1.5.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/oidc-provider": "^9.12.1",
    "@types/qrcode": "1.5.6",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
