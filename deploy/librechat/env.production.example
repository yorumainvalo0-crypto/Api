# Values to set in LibreChat's .env (start from its .env.example, then change these keys).
# Generate every secret with: openssl rand -hex 32  (CREDS_IV: openssl rand -hex 16)

HOST=localhost
PORT=3080
DOMAIN_CLIENT=https://ai.dev.a-b-cloud.de
DOMAIN_SERVER=https://ai.dev.a-b-cloud.de
TRUST_PROXY=1
NO_INDEX=true
APP_TITLE=A-B Cloud AI Portal

# Run containers as the deploy user (check with: id -u / id -g)
UID=1000
GID=1000

# Claude only
ENDPOINTS=anthropic
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
ANTHROPIC_MODELS=claude-sonnet-5-5,claude-opus-5-5,claude-haiku-5-5

# Accounts are created by the admin only
ALLOW_EMAIL_LOGIN=true
ALLOW_REGISTRATION=false
ALLOW_SOCIAL_LOGIN=false
ALLOW_SOCIAL_REGISTRATION=false
ALLOW_UNVERIFIED_EMAIL_LOGIN=true
# Set to true once SMTP (EMAIL_*) is configured
ALLOW_PASSWORD_RESET=false
ALLOW_SHARED_LINKS_PUBLIC=false

# Per-user message rate limit (messages per window in minutes)
LIMIT_MESSAGE_USER=true
MESSAGE_USER_MAX=40
MESSAGE_USER_WINDOW=1

# Secrets
CREDS_KEY=REPLACE_ME_64_HEX
CREDS_IV=REPLACE_ME_32_HEX
JWT_SECRET=REPLACE_ME
JWT_REFRESH_SECRET=REPLACE_ME
MEILI_MASTER_KEY=REPLACE_ME
ADMIN_PANEL_SESSION_SECRET=REPLACE_ME
