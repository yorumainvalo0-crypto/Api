{
  "name": "ai-workbench",
  "productName": "AI Workbench",
  "version": "0.3.1",
  "private": true,
  "description": "Personal desktop AI workbench for coding, chat, web research and media.",
  "author": "Michael Weiss",
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build && npm run smoke",
    "dist:win": "electron-vite build && electron-builder --win --x64",
    "package:dir": "electron-vite build && electron-builder --dir",
    "smoke:packaged": "node scripts/smoke.mjs --packaged"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.296",
    "@anthropic-ai/sdk": "0.133.0",
    "@lydell/node-pty": "1.2.0-beta.15",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@mozilla/readability": "0.6.0",
    "docx": "9.9.0",
    "electron-log": "5.4.4",
    "electron-updater": "6.8.9",
    "fflate": "0.8.3",
    "linkedom": "0.18.13",
    "mammoth": "1.13.0",
    "pptxgenjs": "4.0.1",
    "turndown": "7.2.4",
    "word-extractor": "1.0.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@react-three/fiber": "9.8.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "@types/turndown": "5.0.6",
    "@vitejs/plugin-react": "5.2.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/xterm": "6.0.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "eslint": "10.12.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.13.0",
    "highlight.js": "11.12.0",
    "lucide-react": "1.55.0",
    "pdfjs-dist": "6.4.299",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "rehype-highlight": "7.0.2",
    "remark-gfm": "4.0.1",
    "tailwindcss": "4.3.3",
    "three": "0.186.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  },
  "overrides": {
    "image-size": "2.0.4"
  }
}
